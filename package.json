{
  "name": "case-law-verification-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fixture:pdf": "node scripts/make-sample-pleading.mjs",
    "fixture:docx": "node scripts/make-sample-pleading-docx.mjs",
    "fixture:scanned": "node scripts/make-scanned-pleading.mjs",
    "fixture:ecf-stamp": "node scripts/make-ecf-stamp-only.mjs",
    "test:unit": "tsx scripts/unit-check.ts && tsx scripts/citation-extract-check.ts && tsx scripts/consensus-check.ts && tsx scripts/quote-check.ts && tsx scripts/links-check.ts && tsx scripts/holding-check.ts && tsx scripts/statute-check.ts && tsx scripts/report-check.ts && tsx scripts/regression-check.ts && tsx scripts/blob-limits-check.ts && npm run fixture:ecf-stamp && tsx scripts/text-layer-check.ts && npm run fixture:docx && tsx scripts/docx-check.ts",
    "test:links": "tsx scripts/links-check.ts",
    "test:holding": "tsx scripts/holding-check.ts",
    "test:statute": "tsx scripts/statute-check.ts",
    "test:ocr": "npm run fixture:scanned && tsx scripts/ocr-check.ts",
    "test:controls": "tsx scripts/controls-check.ts",
    "test:pdf": "npm run fixture:pdf && tsx scripts/pdf-verify-check.ts",
    "test:docx": "npm run fixture:docx && tsx scripts/docx-check.ts",
    "test:sample": "tsx scripts/sample-filing-check.ts",
    "test:smoke": "tsx scripts/deploy-smoke-check.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "mammoth": "^1.12.1",
    "next": "15.5.23",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "jszip": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
